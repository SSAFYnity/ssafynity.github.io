---
import Container from '~/components/Container.astro'
import HomeHero from '~/components/HomeHero.astro'
import MemberCelebration from '~/components/MemberCelebration.astro'
import NoticeChannelTransition from '~/components/NoticeChannelTransition.astro'
import LucideIcon from '~/components/LucideIcon.astro'
import SiteLayout from '~/layouts/SiteLayout.astro'
import { allEvents, allPartners, computed } from '@/data/computed'
import { EVENT_AUDIENCE_LABEL, EVENT_FORMAT_LABEL, EVENT_KIND_LABEL } from '@/data/constants'
import { formatEventDate, getEventStatus } from '@/lib/utils'
import { withBaseAsset } from '@/lib/asset'

const pathname = '/'

const stats = [
  { label: '함께하는 동문', value: computed.totalMembers.toLocaleString('ko-KR'), suffix: '명' },
  { label: '참여 기수', value: computed.cohortCount, suffix: '개 기수' },
  { label: '누적 행사', value: computed.totalEvents, suffix: '회' },
  { label: '운영', value: computed.operationYears, suffix: '년째' },
] as const

const publicEvents = allEvents.filter((event) => !event.internal)
const recentEvents = publicEvents
  .filter((event) => getEventStatus(event) === 'past' && event.img)
  .sort((a, b) => b.eventDate.start.localeCompare(a.eventDate.start))
  .slice(0, 3)

const participationPaths = [
  {
    title: '동문회원 가입',
    description: 'SSAFY 교육생·수료생이라면 무료로 가입하고 행사와 커뮤니티 소식을 확인할 수 있습니다.',
    href: '/join/membership',
    action: '가입 안내 확인',
  },
  {
    title: '정회원 등록',
    description: '정기행사 무료 입장과 전용 소통망 등 정회원 운영 혜택을 확인합니다.',
    href: '/join/premium',
    action: '정회원 안내 확인',
  },
  {
    title: '동아리 참여',
    description: '관심사를 중심으로 활동하는 정식·예비 동아리를 살펴보고 직접 참여합니다.',
    href: '/clubs/intro',
    action: '동아리 둘러보기',
  },
] as const
---

<SiteLayout pathname={pathname}>
  <div class="home-v3">
    <HomeHero />

    <section class="home-facts-band" aria-label="SSAFYnity 운영 현황">
      <Container maxWidth="7xl">
        <dl class="home-facts">
          {stats.map((stat) => (
            <div>
              <dt>{stat.label}</dt>
              <dd><strong>{stat.value}</strong><span>{stat.suffix}</span></dd>
            </div>
          ))}
        </dl>
      </Container>
    </section>

    <NoticeChannelTransition />

    <MemberCelebration />

    <section class="home-section home-participation">
      <Container maxWidth="7xl">
        <div class="home-section-heading">
          <h2>필요한 방식으로 참여하세요</h2>
          <p>가입부터 정회원, 동아리 활동까지 각 단계에 필요한 안내를 한곳에서 확인할 수 있습니다.</p>
        </div>

        <div class="home-path-list">
          {participationPaths.map((path) => (
            <a href={path.href} class="home-path-row">
              <span class="home-path-copy">
                <strong>{path.title}</strong>
                <span>{path.description}</span>
              </span>
              <span class="home-path-action">
                {path.action}
                <LucideIcon name="arrow-right" size={16} />
              </span>
            </a>
          ))}
        </div>
      </Container>
    </section>

    <section class="home-section home-records">
      <Container maxWidth="7xl">
        <div class="home-section-heading home-section-heading-row">
          <div>
            <h2>최근 행사를 기록합니다</h2>
            <p>행사가 끝난 뒤에도 일정과 운영 결과를 남겨 다음 활동의 기준으로 사용합니다.</p>
          </div>
          <a href="/events/archive" class="home-section-link">
            모든 행사 기록
            <LucideIcon name="arrow-right" size={16} />
          </a>
        </div>

        <div class="home-record-grid">
          {recentEvents.map((event, index) => (
            <article class:list={['home-record', { 'is-featured': index === 0 }]}>
              <a href={`/events/archive/${event.slug}`} class="home-record-image">
                <img src={withBaseAsset(event.img!)} alt={`${event.title} 행사 이미지`} loading={index === 0 ? 'eager' : 'lazy'} />
              </a>
              <div class="home-record-copy">
                <div class="home-record-meta">
                  <time datetime={event.eventDate.start}>{formatEventDate(event.eventDate)}</time>
                  <span>{event.kind ? EVENT_KIND_LABEL[event.kind] : '행사'}</span>
                </div>
                <h3><a href={`/events/archive/${event.slug}`}>{event.title}</a></h3>
                <p>{event.summary}</p>
                <div class="home-record-detail">
                  <span>{event.format.map((format) => EVENT_FORMAT_LABEL[format]).join(' · ')}</span>
                  {event.audience && <span>{EVENT_AUDIENCE_LABEL[event.audience]}</span>}
                </div>
              </div>
            </article>
          ))}
        </div>
      </Container>
    </section>

    <section class="home-section home-partner">
      <Container maxWidth="7xl">
        <div class="home-partner-inner">
          <div class="home-partner-copy">
            <h2>싸피니티의 출발을 함께한 파트너</h2>
            <p>동문회는 활동의 기반을 제공하는 파트너와 협력하며 운영됩니다.</p>
          </div>
          <div class="home-partner-list">
            {allPartners.map((partner) => (
              <a href={partner.url} target="_blank" rel="noopener noreferrer" class="home-partner-row">
                <img src={withBaseAsset(partner.logo)} alt={partner.name} />
                <span>
                  <strong>{partner.name}</strong>
                  <small>{partner.desc}</small>
                </span>
                <LucideIcon name="external-link" size={16} />
              </a>
            ))}
          </div>
        </div>
      </Container>
    </section>

    <section class="home-join-band">
      <Container maxWidth="7xl">
        <div class="home-join-inner">
          <div>
            <h2>SSAFY에서 만난 인연을<br />수료 뒤에도 이어가세요</h2>
            <p>동문회원 가입은 무료이며, 가입 대상과 절차는 안내 페이지에서 확인할 수 있습니다.</p>
          </div>
          <a href="/join/membership">
            가입 절차 확인
            <LucideIcon name="arrow-right" size={17} />
          </a>
        </div>
      </Container>
    </section>
  </div>
</SiteLayout>

<style>
  .home-v3 {
    background: #fff;
    color: #0f172a;
  }

  .home-facts-band {
    padding: 0 0 64px;
    background: #f8fafc;
  }

  .home-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid #cbd5e1;
    border-bottom: 1px solid #cbd5e1;
  }

  .home-facts > div {
    padding: 22px 0;
  }

  .home-facts > div:nth-child(odd) {
    padding-right: 16px;
  }

  .home-facts > div:nth-child(even) {
    padding-left: 16px;
    border-left: 1px solid #e2e8f0;
  }

  .home-facts > div:nth-child(n + 3) {
    border-top: 1px solid #e2e8f0;
  }

  .home-facts dt {
    color: #64748b;
    font-size: 12px;
    font-weight: 700;
  }

  .home-facts dd {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin: 8px 0 0;
  }

  .home-facts dd strong {
    font-size: 27px;
    font-weight: 850;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .home-facts dd span {
    color: #64748b;
    font-size: 12px;
    font-weight: 700;
  }

  .home-section {
    padding: 88px 0;
  }

  .home-section-heading {
    max-width: 680px;
    margin-bottom: 42px;
  }

  .home-section-heading h2,
  .home-partner-copy h2,
  .home-join-inner h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.35rem);
    font-weight: 830;
    letter-spacing: -0.035em;
    line-height: 1.12;
    text-wrap: balance;
  }

  .home-section-heading p,
  .home-partner-copy p {
    margin: 17px 0 0;
    color: #475569;
    font-size: 15px;
    font-weight: 560;
    line-height: 1.7;
    word-break: keep-all;
  }

  .home-path-list {
    border-top: 1px solid #cbd5e1;
  }

  .home-path-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
    padding: 25px 0;
    border-bottom: 1px solid #e2e8f0;
    color: #0f172a;
    text-decoration: none;
  }

  .home-path-row:hover .home-path-copy strong,
  .home-path-row:hover .home-path-action {
    color: #1d4ed8;
  }

  .home-path-copy {
    display: grid;
    gap: 8px;
  }

  .home-path-copy strong {
    font-size: 19px;
    font-weight: 800;
  }

  .home-path-copy > span {
    max-width: 620px;
    color: #475569;
    font-size: 14px;
    font-weight: 550;
    line-height: 1.65;
  }

  .home-path-action {
    display: inline-flex;
    width: fit-content;
    min-height: 36px;
    align-items: center;
    gap: 7px;
    color: #1e3a8a;
    font-size: 12px;
    font-weight: 750;
  }

  .home-records {
    background: #f8fafc;
  }

  .home-section-heading-row {
    max-width: none;
  }

  .home-section-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 7px;
    margin-top: 20px;
    color: #1e3a8a;
    font-size: 13px;
    font-weight: 750;
    text-decoration: none;
  }

  .home-record-grid {
    display: grid;
    gap: 34px;
  }

  .home-record {
    min-width: 0;
  }

  .home-record-image {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: 14px;
    background: #e2e8f0;
  }

  .home-record-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 240ms ease;
  }

  .home-record-image:hover img {
    transform: scale(1.025);
  }

  .home-record-copy {
    padding-top: 18px;
  }

  .home-record-meta,
  .home-record-detail {
    display: flex;
    flex-wrap: wrap;
    gap: 7px 14px;
    color: #64748b;
    font-size: 11px;
    font-weight: 700;
  }

  .home-record-copy h3 {
    margin: 9px 0 0;
    font-size: 21px;
    font-weight: 820;
    letter-spacing: -0.025em;
    line-height: 1.35;
  }

  .home-record-copy h3 a {
    color: inherit;
    text-decoration: none;
  }

  .home-record-copy h3 a:hover {
    color: #1d4ed8;
  }

  .home-record-copy p {
    margin: 10px 0 13px;
    color: #475569;
    font-size: 13px;
    font-weight: 550;
    line-height: 1.65;
  }

  .home-partner-inner {
    display: grid;
    gap: 40px;
  }

  .home-partner-row {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr) auto;
    align-items: center;
    gap: 20px;
    min-height: 112px;
    padding: 18px 0;
    border-top: 1px solid #cbd5e1;
    border-bottom: 1px solid #cbd5e1;
    color: #0f172a;
    text-decoration: none;
  }

  .home-partner-row img {
    width: 88px;
    max-height: 52px;
    object-fit: contain;
  }

  .home-partner-row > span {
    display: grid;
    gap: 6px;
  }

  .home-partner-row strong {
    font-size: 16px;
    font-weight: 800;
  }

  .home-partner-row small {
    max-width: 620px;
    color: #475569;
    font-size: 12px;
    font-weight: 550;
    line-height: 1.6;
  }

  .home-join-band {
    padding: 72px 0;
    background: #eff6ff;
  }

  .home-join-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
  }

  .home-join-inner h2 {
    color: #1e3a8a;
  }

  .home-join-inner p {
    max-width: 660px;
    margin: 18px 0 0;
    color: #334155;
    font-size: 14px;
    font-weight: 560;
    line-height: 1.7;
  }

  .home-join-inner > a {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    gap: 8px;
    padding: 0 20px;
    border-radius: 10px;
    background: #1e3a8a;
    color: #fff;
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
  }

  .home-join-inner > a:hover {
    background: #172554;
  }

  @media (min-width: 700px) {
    .home-facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .home-facts > div {
      padding: 22px 24px;
      border-top: 0 !important;
      border-left: 1px solid #e2e8f0;
    }

    .home-facts > div:first-child {
      padding-left: 0;
      border-left: 0;
    }

    .home-path-row {
      grid-template-columns: minmax(0, 1fr) 180px;
      align-items: center;
      padding: 28px 0;
    }

    .home-path-action {
      grid-column: auto;
      justify-self: end;
    }

    .home-record-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }

    .home-section-heading-row {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 32px;
    }

    .home-section-heading-row > div {
      max-width: 680px;
    }

    .home-section-link {
      margin-top: 0;
    }

    .home-join-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .home-join-inner > a {
      flex: 0 0 auto;
    }
  }

  @media (min-width: 1024px) {
    .home-section {
      padding: 116px 0;
    }

    .home-partner-inner {
      grid-template-columns: minmax(280px, 0.75fr) minmax(0, 1.25fr);
      align-items: center;
      gap: 96px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-record-image img {
      transition: none;
    }
  }
</style>
