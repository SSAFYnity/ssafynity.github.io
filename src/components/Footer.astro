---
import BrandIcon from '~/components/BrandIcon.astro'
import Container from '~/components/Container.astro'
import LucideIcon from '~/components/LucideIcon.astro'
import { siteData } from '@/data/siteData'
import { withBaseAsset } from '@/lib/asset'

function isUsableSnsUrl(url: string) {
  return url.trim().length > 0 && !url.includes('[업데이트 필요]')
}

function resolveItemHref(item: typeof siteData.menu[number]['items'][number]) {
  if (!import.meta.env.DEV || !item.path.startsWith(siteData.sites.production.blog)) return item.path
  return item.path.replace(siteData.sites.production.blog, siteData.sites.development.blog)
}

const footerSns = siteData.sns.filter((channel) => channel.showInFooter && isUsableSnsUrl(channel.url))
const blogUrl = import.meta.env.DEV ? siteData.sites.development.blog : siteData.sites.production.blog
---

<footer class="official-footer">
  <Container maxWidth="7xl">
    <div class="official-footer-main">
      <div class="official-footer-intro">
        <a href="/" class="official-footer-brand" aria-label="SSAFYnity 공식 홈페이지 홈">
          <img src={withBaseAsset('/logo-rect.png')} alt="" />
          <span>
            <strong>SSAFYnity</strong>
            <small>공식 홈페이지</small>
          </span>
        </a>
        <p>{siteData.brand.slogan}</p>
        <a class="official-footer-switch" href={blogUrl}>
          <span>공지와 활동 기록은 공식 블로그에서 확인하세요</span>
          <LucideIcon name="arrow-right" size={16} />
        </a>
        <div class="official-footer-socials" aria-label="SSAFYnity 소셜 채널">
          {footerSns.map((channel) => {
            const iconName = channel.icon as 'discord' | 'github' | 'gmail' | 'instagram' | 'kakao' | 'linkedin' | 'youtube'
            return (
              <a href={channel.url} target="_blank" rel="noopener noreferrer" aria-label={channel.name} title={channel.name}>
                <BrandIcon name={iconName} size={17} />
              </a>
            )
          })}
        </div>
      </div>

      <nav class="official-footer-nav" aria-label="공식 홈페이지 전체 메뉴">
        {siteData.menu.map((category) => (
          <section>
            <h2>{category.label}</h2>
            <div>
              {category.items.map((item) => (
                <a
                  href={resolveItemHref(item)}
                  target={'external' in item && item.external ? '_blank' : undefined}
                  rel={'external' in item && item.external ? 'noopener noreferrer' : undefined}
                >
                  <span>{item.label}</span>
                  {'external' in item && item.external && <LucideIcon name="external-link" size={11} />}
                </a>
              ))}
            </div>
          </section>
        ))}
      </nav>
    </div>

    <div class="official-footer-meta">
      <div>
        <p>© {new Date().getFullYear()} SSAFYnity. All rights reserved.</p>
        <p>동문회의 사전 허락 없는 무단 크롤링, 스크래핑, 복제 및 재배포를 금합니다.</p>
      </div>
      <div>
        <a href={siteData.legal.privacyPath}>개인정보처리방침</a>
        <a href={siteData.legal.termsPath}>이용약관</a>
      </div>
    </div>
  </Container>
</footer>

<style>
  .official-footer {
    border-top: 1px solid rgba(203, 213, 225, 0.16);
    background: #1e293b;
    color: #f8fafc;
  }

  .official-footer-main {
    display: grid;
    gap: 48px;
    padding: 64px 0 52px;
  }

  .official-footer-intro {
    max-width: 390px;
  }

  .official-footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: #f8fafc;
    text-decoration: none;
  }

  .official-footer-brand img {
    width: auto;
    height: 38px;
    padding: 4px;
    border-radius: 9px;
    background: #f8fafc;
  }

  .official-footer-brand span {
    display: grid;
    gap: 4px;
    line-height: 1;
  }

  .official-footer-brand strong {
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .official-footer-brand small {
    color: #cbd5e1;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .official-footer-intro > p {
    max-width: 320px;
    margin: 24px 0 22px;
    color: #e2e8f0;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.7;
  }

  .official-footer-switch {
    display: flex;
    max-width: 360px;
    min-height: 48px;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 11px 13px;
    border: 1px solid rgba(203, 213, 225, 0.28);
    border-radius: 10px;
    color: #f8fafc;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }

  .official-footer-switch:hover {
    border-color: #cbd5e1;
    background: rgba(248, 250, 252, 0.06);
  }

  .official-footer-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }

  .official-footer-socials a {
    display: inline-grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 1px solid rgba(203, 213, 225, 0.28);
    border-radius: 50%;
    color: #cbd5e1;
  }

  .official-footer-socials a:hover {
    border-color: #f8fafc;
    color: #f8fafc;
  }

  .official-footer-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 34px 28px;
  }

  .official-footer-nav h2 {
    margin: 0 0 14px;
    color: #f8fafc;
    font-size: 13px;
    font-weight: 800;
  }

  .official-footer-nav section > div {
    display: grid;
    gap: 10px;
  }

  .official-footer-nav a {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 5px;
    color: #cbd5e1;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.45;
    text-decoration: none;
  }

  .official-footer-nav a:hover {
    color: #f8fafc;
  }

  .official-footer-meta {
    display: flex;
    flex-direction: column-reverse;
    gap: 22px;
    padding: 25px 0 calc(34px + env(safe-area-inset-bottom));
    border-top: 1px solid rgba(203, 213, 225, 0.18);
  }

  .official-footer-meta > div:first-child {
    display: grid;
    gap: 6px;
  }

  .official-footer-meta p {
    margin: 0;
    color: #94a3b8;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.55;
  }

  .official-footer-meta > div:last-child {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  .official-footer-meta a {
    color: #e2e8f0;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
  }

  @media (min-width: 640px) {
    .official-footer-nav {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .official-footer-meta {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }
  }

  @media (min-width: 1024px) {
    .official-footer-main {
      grid-template-columns: minmax(320px, 0.85fr) minmax(0, 1.4fr);
      gap: 80px;
      padding: 78px 0 64px;
    }
  }
</style>
